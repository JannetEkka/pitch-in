{
 "info": {
  "name": "Pitch In API",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Pitch In's REST API. Sign in with /api/session first (a demo persona); Postman keeps the cookie."
 },
 "variable": [
  {
   "key": "base",
   "value": "http://localhost:8080"
  },
  {
   "key": "pledge_id",
   "value": ""
  },
  {
   "key": "case_id",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "Config",
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base}}/api/config",
     "host": [
      "{{base}}"
     ],
     "path": [
      "api",
      "config"
     ]
    }
   }
  },
  {
   "name": "Users",
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base}}/api/users",
     "host": [
      "{{base}}"
     ],
     "path": [
      "api",
      "users"
     ]
    }
   }
  },
  {
   "name": "Sign in as Ben (demo)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base}}/api/session",
     "host": [
      "{{base}}"
     ],
     "path": [
      "api",
      "session"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n \"user_id\": \"u_ben\"\n}"
    }
   }
  },
